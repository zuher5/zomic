# Zomic environment configuration
# Copy to .env for local use:  cp .env.example .env

# --- Database ---
# SQLite (default):
ZOMIC_DB=zomic.db
# PostgreSQL (production, requires backend swap to a Postgres repository):
# DATABASE_URL=postgres://user:pass@host:5432/zomic

# --- Storage ---
STORAGE_ROOT=data/images
STORAGE_BASE_URL=
IMAGE_REFERER=https://v3.komikcast.fit/

# --- Admin ---
# REQUIRED for admin endpoints. Use a long random value in production.
ZOMIC_ADMIN_TOKEN=

# --- Scraper ---
SCRAPER_TIMEOUT=15
SCRAPER_RETRIES=3
SCRAPER_CONCURRENCY=4
SCRAPER_MAX_BYTES=10485760

# --- API ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
